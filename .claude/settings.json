{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/compile-check.sh",
            "timeout": 120,
            "statusMessage": "Compile-checking before stop..."
          }
        ]
      }
    ]
  }
}
